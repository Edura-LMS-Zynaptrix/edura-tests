# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# Load it before running the tests:  set -a; source .env; set +a

# --- Target environment ---
# Base URL of the gateway under test (no trailing slash needed)
STAGING_API_URL=http://localhost

# --- Required secrets (no defaults; tests fail fast if missing) ---
# Must equal auth_service SECRET_KEY of the target environment
SECRET_KEY=
# Must equal payment_service PayHere credentials of the target environment
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# --- Optional smoke-test settings (defaults shown) ---
SMOKE_TEST_OTP=123456
SMOKE_EMAIL_USER=delivered
SMOKE_EMAIL_DOMAIN=resend.dev
SMOKE_YOUTUBE_VIDEO_ID=M7lc1UVf-VE
SMOKE_EVENT_WAIT_SECONDS=30
# Live integration tests: seconds between requests (gateway limit is 100 per minute)
INTEGRATION_REQUEST_INTERVAL=0.65
